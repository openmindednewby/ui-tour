{
    "name": "@dloizides/ui-tour",
    "version": "1.2.3",
    "description": "In-app guided tours for React Native Web apps: Guide me, Show me and Auto modes with a themed ring, caption, cursor, tour picker and first-run offer. Write controls are never clicked. Web only; renders nothing on native.",
    "keywords": [
        "react",
        "react-native-web",
        "tour",
        "onboarding",
        "walkthrough",
        "guided-tour",
        "dloizides"
    ],
    "author": "dloizides",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/openmindednewby/ui-tour.git"
    },
    "homepage": "https://github.com/openmindednewby/ui-tour#readme",
    "bugs": {
        "url": "https://github.com/openmindednewby/ui-tour/issues"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "react-native": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "browser": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "default": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./expo": {
            "react-native": {
                "types": "./dist/expo/index.d.ts",
                "default": "./dist/expo/index.js"
            },
            "browser": {
                "types": "./dist/expo/index.d.ts",
                "default": "./dist/expo/index.js"
            },
            "require": {
                "types": "./dist/expo/index.d.ts",
                "default": "./dist/expo/index.js"
            },
            "import": {
                "types": "./dist/expo/index.d.mts",
                "default": "./dist/expo/index.mjs"
            },
            "default": {
                "types": "./dist/expo/index.d.ts",
                "default": "./dist/expo/index.js"
            }
        },
        "./testing": {
            "react-native": {
                "types": "./dist/testing/index.d.ts",
                "default": "./dist/testing/index.js"
            },
            "browser": {
                "types": "./dist/testing/index.d.ts",
                "default": "./dist/testing/index.js"
            },
            "require": {
                "types": "./dist/testing/index.d.ts",
                "default": "./dist/testing/index.js"
            },
            "import": {
                "types": "./dist/testing/index.d.mts",
                "default": "./dist/testing/index.mjs"
            },
            "default": {
                "types": "./dist/testing/index.d.ts",
                "default": "./dist/testing/index.js"
            }
        },
        "./playwright": {
            "react-native": {
                "types": "./dist/playwright/index.d.ts",
                "default": "./dist/playwright/index.js"
            },
            "browser": {
                "types": "./dist/playwright/index.d.ts",
                "default": "./dist/playwright/index.js"
            },
            "require": {
                "types": "./dist/playwright/index.d.ts",
                "default": "./dist/playwright/index.js"
            },
            "import": {
                "types": "./dist/playwright/index.d.mts",
                "default": "./dist/playwright/index.mjs"
            },
            "default": {
                "types": "./dist/playwright/index.d.ts",
                "default": "./dist/playwright/index.js"
            }
        }
    },
    "files": [
        "dist",
        "README.md",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "build": "npm run clean && tsup",
        "build:watch": "tsup --watch",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "lint": "eslint src --ext .ts,.tsx",
        "lint:fix": "eslint src --ext .ts,.tsx --fix",
        "typecheck": "tsc --noEmit",
        "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
        "security:audit": "npm audit --audit-level=high",
        "deps:outdated": "npm outdated || exit 0",
        "deps:unused": "npx depcheck --ignores \"@types/jest,@types/node,@types/react,@types/react-dom,rimraf,react-native,react-native-web\"",
        "deps:licenses": "npx license-checker --production --onlyAllow \"MIT;Apache-2.0;ISC;BSD-2-Clause;BSD-3-Clause;0BSD;Unlicense;CC0-1.0;CC-BY-3.0;CC-BY-4.0;Python-2.0;BlueOak-1.0.0\" && npx license-checker --development --onlyAllow \"MIT;Apache-2.0;ISC;BSD-2-Clause;BSD-3-Clause;0BSD;Unlicense;CC0-1.0;CC-BY-3.0;CC-BY-4.0;Python-2.0;BlueOak-1.0.0;LGPL-3.0;LGPL-3.0-only;LGPL-3.0-or-later\"",
        "deps:health": "npm run deps:outdated && npm run deps:unused",
        "prepublishOnly": "npm run clean && npm run build && npm run test",
        "version": "npm run build"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0",
        "react-native": ">=0.74.0",
        "expo-router": ">=4.0.0",
        "@playwright/test": ">=1.40.0"
    },
    "peerDependenciesMeta": {
        "expo-router": {
            "optional": true
        },
        "@playwright/test": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        },
        "react-native": {
            "optional": true
        }
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@types/jest": "^29.5.0",
        "@types/node": "^20.19.32",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^8.57.0",
        "eslint-plugin-react": "^7.34.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-native": "0.81.5",
        "react-native-web": "^0.21.0",
        "rimraf": "^5.0.0",
        "ts-jest": "^29.1.0",
        "tsup": "^8.0.0",
        "typescript": "^5.4.0"
    },
    "typesVersions": {
        "*": {
            "expo": [
                "dist/expo/index.d.ts"
            ],
            "testing": [
                "dist/testing/index.d.ts"
            ],
            "playwright": [
                "dist/playwright/index.d.ts"
            ]
        }
    }
}
